# ESP32-S3-WROOM-1 N16R8 with an OV3660 on the camera FPC.
#
# Written from scratch rather than copied from printer-enclosure's firmware/espnow-c/sdkconfig.defaults,
# which hardcodes CONFIG_ESPTOOLPY_FLASHSIZE_4MB - correct for the C3 and wrong
# here. That exact trap is recorded in printer-enclosure's docs/chamber-sensor.md 3w: the flash size
# silently overrides the board and you lose three quarters of it with no error.

CONFIG_IDF_TARGET="esp32s3"

# N16R8 = 16 MB flash, 8 MB PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM is not optional for a camera: a single SVGA JPEG frame buffer does not
# fit in internal RAM, and esp_camera_init fails outright without it.
#
# OCT, not QUAD. The R8 suffix on an S3 module means octal PSRAM, and choosing
# quad here produces a boot loop with a PSRAM ID error rather than a clean
# message - so a wrong guess reads as a dead board.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# The default single-app partition is 1 MB, and the camera component alone
# pushes past it once JPEG support is linked in.
# Two OTA slots. The single-app layout has no ota partitions, so OTA cannot
# work with it no matter what the firmware does.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CONSOLE: deliberately NOT set to USB_SERIAL_JTAG.
#
# This board has TWO USB-C ports. The one in use is the CH343 UART bridge
# (COM9), which is fed by UART0 on GPIO43/44 - the IDF default. Selecting
# USB_SERIAL_JTAG would send every log line out the OTHER connector, and the
# board would look dead while running perfectly. That is precisely what
# happened with the C3-MINI-1 on COM8; see printer-enclosure's docs/chamber-sensor.md 3y.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# ---------------------------------------------------------------- throughput
#
# WHY THESE EXIST. The first benchmark measured 0.19 MB/s of TCP at -27 dBm,
# which is roughly 1.5 Mbit/s on an excellent signal - far below what an S3 can
# do. The giveaway was that the capture-and-send pipeline measured FASTER than
# sending a buffer already in RAM, which is backwards and can only happen if the
# send path is being throttled rather than the radio.
#
# The cause is ESP-IDF's defaults, which are sized for low memory rather than
# speed: a 5760-byte TCP send buffer and receive window, and few WiFi buffers.
# A 5760-byte window caps throughput at window/RTT regardless of link rate.
#
# These values follow Espressif's own iperf example.

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_SACK_OUT=y

# 240 MHz rather than the 160 MHz default. Helps the TCP stack, and should also
# cut the 589 ms software JPEG encode.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ------------------------------------------------------------------ rollback
#
# THE SAFETY NET FOR A BOARD NOBODY CAN REACH. Without this, a pushed image
# that validates and BOOTS but then crashes before it can serve - a camera-init
# hang, a WiFi regression - is permanent: it comes up, dies, and never offers
# an OTA endpoint to push a fix to. The only recovery is a USB cable, which
# means unscrewing a camera from inside a printer enclosure.
#
# With it, a new image boots as PENDING_VERIFY and is only made permanent when
# esp_ota_mark_app_valid_cancel_rollback() runs - which ota_start() calls after
# WiFi is up and the OTA endpoint is serving. An image that cannot get that far
# is rolled back to the previous slot on the next reset, automatically.
#
# ⚠️ THIS IS A BOOTLOADER OPTION, AND OTA DOES NOT REPLACE THE BOOTLOADER.
# It can therefore only ever be enabled over USB. Turning it on after the board
# is mounted is impossible - which is the whole reason it is on now.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
