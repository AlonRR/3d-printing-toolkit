/* Copy to wifi_secrets.h and fill in. wifi_secrets.h is gitignored and must
 * stay so - it holds the only copies of these values in the repo.
 *
 * There was no committed example until 11 Sep 2026, which meant a fresh clone
 * could not build and had to guess the macro names from compiler errors.
 */

#pragma once

#define WIFI_SSID            "YOUR_SSID"
#define WIFI_PASSWORD        "YOUR_WIFI_PASSWORD"

#define MQTT_HOST            "mqtt.your.lan"
#define MQTT_PORT            1883
#define MQTT_USERNAME        "esp"
#define MQTT_PASSWORD        "YOUR_MQTT_PASSWORD"

/* Prusa Connect camera token, if the Connect uploader is used. */
#define PRUSA_CAMERA_TOKEN   "YOUR_PRUSA_CONNECT_TOKEN"

/* Compared byte-for-byte against the X-OTA-Key header on POST /ota. Not
 * authentication - the transport is plain HTTP on a LAN - but it stops an
 * accidental or casual overwrite, which is the realistic risk. */
#define OTA_PASSWORD         "YOUR_OTA_KEY"
