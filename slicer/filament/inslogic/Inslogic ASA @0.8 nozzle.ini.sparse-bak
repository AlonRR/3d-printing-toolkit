# Inslogic ASA — Prusa MK3S+, 0.8 nozzle
# Built from Inslogic ASA Technical Data Sheet (rev. 12.02.2024).
# NOTE: the TDS lists 0.2 / 0.4 / 0.6 mm nozzles only — 0.8 is outside vendor
# spec. It works fine in practice (a bigger nozzle is more forgiving, not less),
# but the temps below come from the TDS's high-flow band, not from a 0.8 entry.
inherits = Prusament ASA @0.8 nozzle
filament_vendor = Inslogic
filament_type = ASA
filament_diameter = 1.75
filament_density = 1.05
filament_cost = 69
filament_spool_weight = 1000
filament_colour = #FFF2EC
temperature = 265
first_layer_temperature = 265
bed_temperature = 100
first_layer_bed_temperature = 100
fan_always_on = 1
min_fan_speed = 20
max_fan_speed = 20
bridge_fan_speed = 30
disable_fan_first_layers = 4
min_print_speed = 5
filament_max_volumetric_speed = 15
filament_notes = "Inslogic ASA @0.8 nozzle — TDS rev. 12.02.2024.\n\nVENDOR SPEC:\nDiameter 1.75 +/- 0.02 mm, 1 kg spool. Density 1.05 g/cm3.\nDrying: 80 C for 4 h.\nNozzle sizes: 0.2 / 0.4 / 0.6 mm — 0.8 IS NOT LISTED by Inslogic.\nNozzle temp: 250-260 C at 50-100 mm/s; 260-280 C at 100-200 mm/s.\nBed: 80-100 C. Bed type: smooth PEI / high-temp plate.\nShrinkage at 23 C: 0.4-0.9 %. Tg 108 C, HDT(0.45 MPa) 98 C.\n\n265 C is used because a 0.8 nozzle pushes far more material per second than\na 0.4, so it sits in the TDS's high-flow band (260-280 C). This also matches\nthe Prusament ASA @0.8 parent exactly.\n\nDELIBERATE DEVIATION FROM TDS:\nThe TDS says 100 % cooling fan. Not applied — see the 0.4 profile's notes.\nFan stays at 20 %, off for the first 4 layers.\n\nUNTESTED - no calibration print has been run with this profile yet."
