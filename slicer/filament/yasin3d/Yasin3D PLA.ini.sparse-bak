# Yasin3D PLA — Prusa MK3S+, 0.4 / 0.6 nozzle
# The 0.4-family sibling of the existing `Yasin3D PLA @0.8 nozzle`.
# Yasin3D publishes no technical data sheet, so every printing number here is
# Prusa's Generic PLA value, unmodified. This is a starting point, not a
# calibration. See README.md in this folder.
inherits = Generic PLA
filament_vendor = Yasin3D
filament_type = PLA
filament_diameter = 1.75
filament_cost = 39
filament_spool_weight = 1000
first_layer_temperature = 210
filament_notes = "Yasin3D PLA - no vendor data sheet exists.\n\nWHAT IS ACTUALLY KNOWN: the vendor, the material type, 1.75 mm, and the price. Everything else - 210 C, 60 C bed, 100 % fan, 15 mm3/s, density 1.24 - is inherited from Prusa's Generic PLA and is a generic default, not a Yasin3D figure.\n\nPRICE: 39 ILS, carried over from the existing 'Yasin3D PLA @0.8 nozzle' profile. Yasin3D PLA is NOT in the current filamentcenter.co.il catalogue (checked 29 Aug 2026 - only PETG at 39 ILS and ABS at 49 ILS are listed), so this figure is historical, not a current listing.\n\nDELIBERATE EDIT: first layer set to 210 C, equal to the print temperature, rather than the parent's +5 C. This mirrors the same edit already made in the @0.8 profile, so the pair behaves the same way at both nozzle sizes.\n\nUNTESTED - no calibration print has been run with this profile yet."
