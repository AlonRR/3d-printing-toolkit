# Yasin3D ASA — Prusa MK3S+, 0.4 / 0.6 nozzle
# The 0.4-family sibling of the existing `Yasin3D ASA @0.8 nozzle`.
# Yasin3D publishes no technical data sheet, so every printing number here is
# Prusa's Prusament ASA value. See README.md in this folder.
inherits = Prusament ASA
filament_vendor = Yasin3D
filament_type = ASA
filament_diameter = 1.75
filament_cost = 54
filament_spool_weight = 1000
first_layer_bed_temperature = 110
filament_notes = "Yasin3D ASA - no vendor data sheet exists.\n\nWHAT IS ACTUALLY KNOWN: the vendor, the material type, 1.75 mm, and the price. Everything else - 260 C, 20 % fan off for the first 4 layers, 11 mm3/s, density 1.07 - is inherited from Prusament ASA and is Prusa's figure, not Yasin3D's.\n\nPRICE: 54 ILS, carried over from the existing 'Yasin3D ASA @0.8 nozzle' profile. Yasin3D ASA is NOT in the current filamentcenter.co.il catalogue (checked 29 Aug 2026 - only PETG at 39 ILS and ABS at 49 ILS are listed), so this figure is historical, not a current listing.\n\nDELIBERATE EDIT: first-layer bed raised from the parent's 105 C to 110 C, so both layers run at 110. This mirrors the same edit already made in the @0.8 profile.\n\nASA needs the enclosure and produces fumes worth extracting - the same conditions as the Inslogic ASA profiles.\n\nUNTESTED - no calibration print has been run with this profile yet."
